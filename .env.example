# Run scripts/setup.ps1 (Windows) or scripts/setup.sh to generate unique local values.
# These placeholders must never be used as real credentials.
APP_ORIGIN=https://localhost:8443
HTTPS_PORT=8443
HTTP_PORT=8080
NEO4J_PASSWORD=GENERATE_WITH_SETUP
ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_BASE64
ADMIN_EMAIL=admin@neo4flix.local
ADMIN_PASSWORD=GENERATE_WITH_SETUP

# Optional Google OAuth2 / OpenID Connect (Web application client).
# Authorized redirect URI: <APP_ORIGIN>/api/auth/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional GitHub OAuth App (no repository scopes).
# Authorization callback URL: <APP_ORIGIN>/api/auth/oauth2/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Leave empty normally. Optional Java trust-store flags for an already trusted HTTPS inspection CA.
# See docs/oauth2.md. Public Google certificates work with the image's standard CA store.
OAUTH_JAVA_OPTIONS=
